# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma) — se completa en Fase 3, cuando exista el proyecto Supabase
DATABASE_URL=
DIRECT_URL=

# Mercado Pago (Fase 8) — desarrollar con credenciales de TEST hasta tener el CUIT/CUIL definitivo
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# URL pública de la app (back_urls/notification_url de MP y redirects de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login con Google: solo "true" si el provider está habilitado en Supabase
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Resend (Fase 10) — sin key, los emails se loguean a consola en dev
RESEND_API_KEY=
RESEND_FROM="Hazing <pedidos@hazing.com.ar>"
RESEND_OWNER_EMAIL=

# PostHog (analítica) — sin key, analytics desactivado
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Scripts / E2E (no son secrets de la app)
ADMIN_EMAIL=
ADMIN_PASSWORD=
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
